# Lab packs live under scripts/local/ (ignored from repo root).
# Keep this file short — move new one-shots into local/{ops,tests,vast}.

# Underscore drafts under ops/ (tracked helpers allowlisted)
ops/_*.sh
ops/_*.py
!ops/_deploy_ssh_retry.sh
!ops/_json_curl_helpers.sh

# Retired one-shots in archive/
ops/archive/*.sh

# Display-fleet cosmetics (keep on disk under ops/ for stable paths; not public)
ops/start_test_named_fleet.sh
ops/stop_test_named_fleet.sh
ops/start_test_named_fuzz_fleet.sh
ops/stop_test_named_fuzz_fleet.sh
ops/stop_test_named_fleet_desktop_extra.sh
ops/stop_test_named_fleet_tail5.sh
ops/named_hybrid_unit.sh
ops/fleet_profit_status.sh
ops/fleet_profit_watchdog.sh
ops/fleet_settle_named.sh
ops/desktop_extra_live_activity.sh
ops/systemd/hackme-test-named-fleet*.service
ops/systemd/hackme-desktop-extra-live-activity.*
