#!/bin/sh
# Casper live needs overlay before setup_overlay() — modprobe cannot load .ko.zst without zstd.
PREREQ=""

prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs)
  prereqs
  exit 0
  ;;
esac

PATH=/usr/sbin:/usr/bin:/sbin:/bin
INSMOD=/usr/bin/insmod
[ -x "$INSMOD" ] || INSMOD=/sbin/insmod

_hm_log() {
  echo "hackme-live: $*" >/dev/kmsg 2>/dev/null || true
  echo "hackme-live: $*" >/dev/console 2>/dev/null || true
}

_hm_overlay_ready() {
  [ -d /sys/module/overlay ] && return 0
  grep -qE '^overlay[[:space:]]' /proc/modules 2>/dev/null && return 0
  return 1
}

_hm_insmod_ko() {
  _ko="$1"
  [ -f "$_ko" ] || return 1
  if "$INSMOD" "$_ko" 2>/tmp/hackme-insmod.err; then
    return 0
  fi
  if grep -qE 'File exists|already in kernel' /tmp/hackme-insmod.err 2>/dev/null; then
    return 0
  fi
  _hm_log "insmod $(basename "$_ko") failed: $(tr '\n' ' ' </tmp/hackme-insmod.err 2>/dev/null)"
  return 1
}

# Codec stack first (enables modprobe for other .ko.zst), then uncompressed fallbacks.
for m in zstd lz4 lzma2 xz libcrc32c crc32c_intel squashfs loop isofs iso9660 udf vfat ext4 sd_mod usb_storage; do
  if [ -f "/hackme-kmods/${m}.ko" ]; then
    _hm_insmod_ko "/hackme-kmods/${m}.ko" 2>/dev/null || true
  fi
  /sbin/modprobe -q -f "$m" 2>/dev/null || true
done

if ! _hm_overlay_ready; then
  _hm_insmod_ko /hackme-kmods/overlay.ko 2>/dev/null || true
  /sbin/modprobe -q -f overlay 2>/dev/null || true
fi

if ! _hm_overlay_ready; then
  _hm_log "FATAL overlay module not loaded (casper-premount)"
fi

exit 0
