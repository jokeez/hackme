#!/bin/sh
# Fallback for non-casper local boots. Live USB uses casper-premount/05-hackme-overlay-modules.
# Fixes: (initramfs) /cow format specified as 'overlay' and no support found
PREREQ=""

prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs)
  prereqs
  exit 0
  ;;
esac

for m in zstd lz4 lzma2 xz squashfs loop overlay isofs iso9660 udf vfat ext4 sd_mod usb_storage; do
  modprobe "$m" 2>/dev/null || true
done

if ! grep -q overlay /proc/filesystems 2>/dev/null; then
  echo "hackme-live: FATAL overlay module not loaded" >/dev/console 2>/dev/null || true
  echo "hackme-live: FATAL overlay module not loaded" >/dev/kmsg 2>/dev/null || true
fi

exit 0
