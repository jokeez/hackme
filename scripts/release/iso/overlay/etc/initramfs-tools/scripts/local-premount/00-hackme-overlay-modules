#!/bin/sh
# Non-casper boots; live ISO uses casper-premount/05-hackme-overlay-modules.
PREREQ=""

prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs)
  prereqs
  exit 0
  ;;
esac

if [ -x /scripts/casper-premount/05-hackme-overlay-modules ]; then
  /scripts/casper-premount/05-hackme-overlay-modules "$@"
  exit 0
fi

PATH=/usr/sbin:/usr/bin:/sbin:/bin
INSMOD=/usr/bin/insmod
[ -x "$INSMOD" ] || INSMOD=/sbin/insmod
for ko in /hackme-kmods/zstd.ko /hackme-kmods/overlay.ko; do
  [ -f "$ko" ] && "$INSMOD" "$ko" 2>/dev/null || true
done
/sbin/modprobe -q -f overlay 2>/dev/null || true
exit 0
