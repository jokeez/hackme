#!/bin/sh
# Force live-boot modules into initramfs (overlay/squashfs must load before casper panics).
PREREQ=""
prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

for mod in zstd lz4 lzma2 xz squashfs loop overlay isofs iso9660 udf vfat ext4 sd_mod usb_storage; do
  manual_add_modules "$mod" 2>/dev/null || true
done
if [ -x /etc/initramfs-tools/scripts/local-premount/hackme-overlay-modules ]; then
  copy_exec /etc/initramfs-tools/scripts/local-premount/hackme-overlay-modules \
    /scripts/local-premount/hackme-overlay-modules
fi
# Ensure depmod ran so modprobe in local-premount resolves .ko.zst chains.
if command -v depmod >/dev/null 2>&1; then
  depmod -a 2>/dev/null || true
fi
