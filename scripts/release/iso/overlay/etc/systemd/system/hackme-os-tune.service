[Unit]
Description=HackMe OS — CPU / GPU tuning (after live boot)
After=network-online.target local-fs.target
Wants=network-online.target
ConditionPathExists=/opt/hackme/scripts/release/iso/hackme-os-tune.sh

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/hackme/scripts/release/iso/hackme-os-tune.sh
SuccessExitStatus=0 1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
