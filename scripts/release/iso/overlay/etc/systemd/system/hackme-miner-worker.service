[Unit]
Description=HackMe OS pool worker (max priority → hackme.tech)
After=network-online.target hackme-os-tune.service hackme-miner-firstboot.service hackme-init-worker.service
Wants=network-online.target hackme-os-tune.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/hackme
EnvironmentFile=-/etc/hackme/miner.env
EnvironmentFile=-/var/lib/hackme/miner.env
EnvironmentFile=-/var/lib/hackme/rig.env
ExecStart=/opt/hackme/scripts/release/iso/run-miner-worker.sh
Restart=on-failure
RestartSec=5
Nice=-10
LimitNOFILE=65535
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
