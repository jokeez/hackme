[Unit]
Description=HackMe Miner console status (tty1)
After=hackme-miner-worker.service

[Service]
Type=simple
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/bin/bash -c 'while true; do /opt/hackme/scripts/release/iso/hackme-miner-status.sh; echo; sleep 30; done'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
