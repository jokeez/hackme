[Unit]
Description=HackMe Miner console status on tty1 (does not replace getty)
After=getty@tty1.service plymouth-quit.service hackme-init-worker.service hackme-zk-display.service
Wants=getty@tty1.service

[Service]
Type=simple
ExecStart=/opt/hackme/scripts/release/iso/hackme-miner-status-loop.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
