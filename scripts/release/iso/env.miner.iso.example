# Build-time overrides for HackMe Miner ISO (optional).
# Copy to env.miner.iso and source before build, or export variables inline.
#
#   set -a && source scripts/release/iso/env.miner.iso && set +a
#   VERSION=0.1.0-rc11g bash scripts/release/iso/build_hackme_miner_iso.sh

# Public pool (default)
# COORD_URL=https://hackme.tech/pool/coordinator
# PUBLIC_AUTHORITY=https://hackme.tech

# Worker claim/submit token — same as Windows pool.miner.token (build embeds into ISO)
# HACKME_RELEASE_POOL_MINER_TOKEN=

# Ubuntu suite for debootstrap chroot
# UBUNTU_SUITE=noble

# Skip release tarball rebuild when dist/ already has linux payload
# SKIP_RELEASE_BUILD=1
