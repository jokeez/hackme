# Rename to hackme.env next to hackme.exe (or run setup_hackme_miner.bat — it writes hackme.env for you).
#
# Public pool at hackme.tech — coordinator URL is inferred from HACKME_PUBLIC_AUTHORITY_BASE.
HACKME_PUBLIC_AUTHORITY_BASE=https://hackme.tech

# Local dashboard secret (auto-generated by setup_hackme_miner.bat on each PC).
# HACKME_ADMIN_TOKEN=

# Pool miner token (claim/submit). Shipped in pool.miner.token inside the release zip.
# Do not share publicly if you run a private pool — rebuild release with your own token.
# HACKME_POOL_COORDINATOR_TOKEN=

HACKME_REQUIRE_ADMIN_TOKEN=1
HACKME_WORKER_BATCH_SIZE=4194304
