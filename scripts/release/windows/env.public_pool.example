# Rename to ".env" or "hackme.env" next to hackme.exe (HackMe loads these on startup; does not override existing system env).
#
# Public command node (canonical height + pool API). Coordinator URL is inferred:
#   HTTPS without port -> https://<host>/pool/coordinator
HACKME_PUBLIC_AUTHORITY_BASE=https://hackme.tech

# Local dashboard admin secret (must match what you paste in the UI if REQUIRE_ADMIN_TOKEN is on).
# HACKME_ADMIN_TOKEN=

# Pool coordinator admin token from the operator (required for Start pool worker against the public coordinator).
# HACKME_POOL_COORDINATOR_TOKEN=
