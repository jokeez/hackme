# Example apt source entries for HackMe (L3 — not live until signed + hosted).
#
# Production (future):
#   deb [signed-by=/usr/share/keyrings/hackme-archive-keyring.gpg] https://hackme.tech/apt stable main
#   # optional RC channel:
#   # deb [signed-by=/usr/share/keyrings/hackme-archive-keyring.gpg] https://hackme.tech/apt rc main
#
# Local unsigned dry-run (generated by build_local_apt_repo.sh):
#   deb [trusted=yes] file:/ABS/PATH/TO/HackMe/dist/apt/repo unstable main
#
# Install:
#   sudo apt update
#   sudo apt install hackme-node
#
# Until L3 is public, prefer L1:
#   bash /opt/hackme/update_hackme_miner.sh
