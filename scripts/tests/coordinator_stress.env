# Local coordinator profile for mega stress (do not use in production).
export HACKME_COORDINATOR_ADDR="${HACKME_COORDINATOR_ADDR:-127.0.0.1:8082}"
export HACKME_COORDINATOR_DB="${HACKME_COORDINATOR_DB:-data/coordinator_stress.db}"
export HACKME_COORDINATOR_ADMIN_TOKEN="${HACKME_COORDINATOR_ADMIN_TOKEN:-stress-coord-admin-token}"
export HACKME_COORDINATOR_REQUIRE_ADMIN_TOKEN=1
export HACKME_COORDINATOR_ALLOW_INSECURE=0
export HACKME_COORDINATOR_CLAIM_PER_MIN=200000
export HACKME_COORDINATOR_SUBMIT_PER_MIN=500000
export HACKME_COORDINATOR_MAX_WORKERS=256
export HACKME_COORDINATOR_MAX_ACTIVE_LEASES=20000
export HACKME_COORDINATOR_MAX_ACTIVE_LEASES_PER_WORKER=64
export HACKME_COORDINATOR_MAX_DEDUP_ENTRIES=500000
export HACKME_COORDINATOR_BAD_STRIKES_TO_BAN=1000000
export HACKME_COORDINATOR_BAN_SEC=1
export HACKME_COORDINATOR_LEASE_SEC=30
export HACKME_POOL_HYBRID_SIGNER_ENABLED=0
