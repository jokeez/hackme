# Copy to .env.telegram in the HackMe repo root (or use -config /path/to/file):
#   cp scripts/ops/telegram_bot.env.example .env.telegram
#
# Then from repo root:
#   go run ./cmd/telegrambot
#   # or: bash scripts/ops/telegram_bot_up.sh
#
# Shell `export VAR=...` overrides values from the file.
#
# Create a bot via @BotFather → token:
TELEGRAM_BOT_TOKEN=

# Your HackMe node HTTP base (no trailing slash). VPS pool node:
HACKME_TELEGRAM_NODE_URL=http://127.0.0.1:18080

# Optional→required for access: only these Telegram numeric user IDs may use the bot.
# Empty / unset = deny all (fail-closed). Comma-separated.
HACKME_TELEGRAM_ALLOWED_USER_IDS=123456789

# Optional: path to this env file if you keep secrets outside the repo (see docs/TELEGRAM_BOT.md).
# HACKME_TELEGRAM_CONFIG=/home/you/operator.env

# Optional: pass-through admin header for the node (GET routes used by the bot are usually public).
# HACKME_ADMIN_TOKEN=

# Background “new blocks” watcher poll interval (seconds), 20–600, default 45:
# HACKME_TELEGRAM_WATCH_POLL_SEC=45
