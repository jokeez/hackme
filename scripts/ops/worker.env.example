COORD_URL=http://127.0.0.1:18081
# Coordinator admin (claim/submit). Prefer COORD_ADMIN_TOKEN or HACKME_COORDINATOR_ADMIN_TOKEN,
# legacy alias COORD_TOKEN, or one-line file .secrets/hackme_coordinator_admin_token (VPS HACKME_COORDINATOR_ADMIN_TOKEN).
COORD_ADMIN_TOKEN=REPLACE_WITH_COORDINATOR_ADMIN_TOKEN
WORKER_ID=worker-local-01

# Required for hybrid signed submits (64 hex chars = 32-byte seed).
HACKME_MINER_ED25519_SEED_HEX=REPLACE_WITH_64_HEX_SEED

# Optional tuning (local loopback lab):
# BATCH_SIZE=4194304
# GPU_CHUNK=4194304
# SEARCH_TIMEOUT_MS=2500
#
# Remote GPU desktop (direct + 16M + cooldown 100):
# HACKME_DESKTOP_GPU_POOL=1
# HACKME_POOL_DIRECT=1
# COORD_URL=http://132.243.112.100:18083
# BATCH_SIZE=16777216
# GPU_CHUNK=4194304
# HACKME_WORKER_CLAIM_COOLDOWN_MS=100
#
# Optional GPU selection:
# HACKME_GPU_BACKEND=auto
# HACKME_GPU_DEVICE=
# HACKME_GPU_DISABLE=0
