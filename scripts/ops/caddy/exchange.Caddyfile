{
	email admin@hackme.tech
	servers {
		protocols h1 h2
	}
}

(exchange_site) {
	encode gzip
	# Same-origin oracle/hub proxies — browser CSP connect-src self (no CORS on hub)
	handle_path /pool-proxy/* {
		rewrite * /pool/coordinator{path}
		reverse_proxy https://hackme.tech {
			header_up Host hackme.tech
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
	handle_path /hub-proxy/* {
		rewrite * {path}
		reverse_proxy https://hackme.tech {
			header_up Host hackme.tech
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	# BTC/USDT mark for HMC/BTC+SUP/BTC — same-origin only (no api.binance.com in CSP).
	handle /mark-proxy/btc {
		rewrite * /api/v3/ticker/price?symbol=BTCUSDT
		reverse_proxy https://api.binance.com {
			header_up Host api.binance.com
			header_up X-Forwarded-Proto {scheme}
		}
	}
	handle /mark-proxy/* {
		respond 404
	}

	# Public desk Connect: same-origin API so Strict cookies work.
	# HSTS must be set here too — parent `handle` headers do not apply to this reverse_proxy.
	handle_path /desk-api/* {
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			-Server
		}
		reverse_proxy 127.0.0.1:18444 {
			header_up Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-For {remote_host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Never expose matching API on public paper host under /api
	handle /api/* {
		respond 404
	}
	handle /lab/* {
		respond 404
	}
	handle /admin/* {
		respond 404
	}
	handle /health {
		respond 404
	}
	handle /openapi.yaml {
		respond 404
	}

	handle {
		root * /var/www/exchange
		try_files {path} /index.html
		file_server
		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://hackme.tech; connect-src 'self' https://hackme.tech; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self' https://hackme.tech http://127.0.0.1:8080 http://localhost:8080"
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy cross-origin
			-X-Frame-Options
			-Server
		}
		@assets {
			path /assets/*
			not path /assets/boot-*
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@boot_assets path /assets/boot-* /index.html
		header @boot_assets Cache-Control "no-cache"
	}
}

http://89.150.41.40, :80 {
	import exchange_site
}

exchange.hackme.tech {
	import exchange_site
}

:88, :8444 {
	respond "gone" 410
}

# --- public desk API (HOLD: matching/deposit/withdraw OFF) ---
exchange-api.hackme.tech, api.exchange.hackme.tech {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
	map {header.CF-Connecting-IP} {desk_client_ip} {
		"" {remote_host}
		default {header.CF-Connecting-IP}
	}
	reverse_proxy 127.0.0.1:18444 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {desk_client_ip}
		header_up X-Real-IP {desk_client_ip}
	}
}
