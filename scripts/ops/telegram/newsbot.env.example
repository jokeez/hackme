# Telegram Bot token from @BotFather (channel admin: Post Messages)
TG_BOT_TOKEN=1234567890:replace_me

# Channel target. Prefer @channel_username for public channel.
TG_CHAT_ID=@hackme_tech

# News source and link target
NEWS_FEED_URL=https://hackme.tech/assets/news.json
NEWS_PAGE_BASE=https://hackme.tech/news.html#

# Site origin for miner shortcut buttons (optional; else derived from NEWS_PAGE_BASE)
# NEWS_SITE_HOME=https://hackme.tech

# Status filter: comma-separated lower-case statuses never posted (recorded as ignored).
# Use NEWS_BLOCKED_STATUSES=none to post every status (not recommended).
NEWS_BLOCKED_STATUSES=draft

# Miner-oriented UI: second button row + hint line (1/true = on, 0/false = off)
NEWS_MINER_BUTTON_ROW=1
NEWS_MINER_HINT_LINE=1

# Polling/runtime
POLL_INTERVAL_SEC=60
HTTP_TIMEOUT_SEC=20
HTTP_FETCH_RETRIES=3
POST_RETRIES=4
POST_GAP_SEC=1.1

# Telegram HTML body cap (bytes-ish length; safe under 4096 limit)
TELEGRAM_MAX_TEXT=3900

# Persistent state (anti-duplicate + ignored drafts). JSON: posted_ids, ignored_ids.
STATE_FILE=/opt/hackme/data/news-bot-state.json
