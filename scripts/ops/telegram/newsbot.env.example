# Telegram Bot token from @BotFather (channel admin: Post Messages)
TG_BOT_TOKEN=1234567890:replace_me

# Channel target. Prefer @channel_username for public channel.
TG_CHAT_ID=@hackme_tech

# Operator/admin chat for pool heartbeat (every 4h). Use numeric id or @group.
TG_ADMIN_CHAT_ID=

# Pool heartbeat (cmd/news-bot = news_channel_bot.py service)
POOL_HEARTBEAT_INTERVAL_SEC=14400
POOL_STATUS_URL=https://hackme.tech/api/status?lite=1
POOL_WORK_STATS_URL=https://hackme.tech/pool/coordinator/api/work/stats?details=0

# News source and link target
NEWS_FEED_URL=https://hackme.tech/assets/news-feed.json
NEWS_PAGE_BASE=https://hackme.tech/news.html#

# Site origin for miner shortcut buttons (optional; else derived from NEWS_PAGE_BASE)
# NEWS_SITE_HOME=https://hackme.tech

# Status filter: comma-separated lower-case statuses never posted (recorded as ignored).
# Use NEWS_BLOCKED_STATUSES=none to post every status (not recommended).
NEWS_BLOCKED_STATUSES=draft

# Channel UI (v3: no tags, no Telegram self-links in buttons)
NEWS_MINER_BUTTON_ROW=1
NEWS_MINER_HINT_LINE=1
NEWS_SHOW_GITHUB_BUTTON=0

# Polling/runtime
POLL_INTERVAL_SEC=60
HTTP_TIMEOUT_SEC=20
HTTP_FETCH_RETRIES=3
POST_RETRIES=4
POST_GAP_SEC=1.1

# Telegram HTML body cap (bytes-ish length; safe under 4096 limit)
TELEGRAM_MAX_TEXT=3900

# One Telegram post per poll cycle (backlog drains slowly; prevents burst spam).
MAX_POSTS_PER_CYCLE=1

# Persistent state (anti-duplicate + ignored drafts + fingerprints).
# JSON: posted_ids, ignored_ids, posted_fingerprints.
STATE_FILE=/opt/hackme/data/news-bot-state.json
# Exclusive lock shared by daemon and publish_news_to_telegram.sh --once.
STATE_LOCK_FILE=/opt/hackme/data/news-bot-state.json.lock
