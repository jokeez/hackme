# Production pool hardening — copy relevant lines to VPS coordinator + command node env.
# Never commit real tokens. See docs/SECURITY_AUDIT_REDTEAM.md

# --- Coordinator (127.0.0.1 only; nginx proxies /pool/coordinator) ---
HACKME_COORDINATOR_ADMIN_TOKEN=REPLACE_WITH_STRONG_SECRET
HACKME_COORDINATOR_ADDR=127.0.0.1:18081
HACKME_COORDINATOR_REQUIRE_ADMIN_TOKEN=1
# HACKME_COORDINATOR_ALLOW_INSECURE=1   # NEVER on production

# Public fair pool: 0 = pay accepted attempts (capped by batch) + hybrid strict. Use 1 only for ultra-paranoid found-only mode.
HACKME_COORDINATOR_PAYOUT_FOUND_ONLY=0
HACKME_COORDINATOR_REWARD_AUTO=1
HACKME_POOL_HYBRID_SIGNER_ENABLED=1
HACKME_POOL_HYBRID_SIGNER_STRICT=1
HACKME_POOL_HYBRID_REQUIRE_FOUND_SIG=1

# --- Command node ---
HACKME_ADMIN_TOKEN=REPLACE_WITH_STRONG_SECRET
HACKME_REQUIRE_ADMIN_TOKEN=1
HACKME_BIND_ADDR=127.0.0.1:18080

# --- P2P (only if enabled) ---
HACKME_P2P_TOKEN=REPLACE_WITH_STRONG_SECRET

# --- Settlement (cron on chain host) ---
# WORKER_PAYOUT_MAP=worker-id=HMC-...
# ADMIN_TOKEN same as node admin for /api/tx/send from loopback

# --- Desktop miners (local PC) ---
# HACKME_PUBLIC_AUTHORITY_BASE=https://hackme.tech
# Remote pool worker (HTTPS): smaller batch + longer HTTP timeouts
# HACKME_WORKER_BATCH_SIZE=1048576
# HACKME_WORKER_CLAIM_TIMEOUT=90s
# HACKME_WORKER_SUBMIT_TIMEOUT=120s
# WORKER_PAYOUT_MAP=worker-kapa-pc=HMC-...
# WORKER_PAYOUT_MAP=worker-my-pc=HMC-...
# Do not set HACKME_DESKTOP_EXPOSE_ADMIN_TOKEN=1
