# Free Fuzz Week intake — copy to /opt/hackme/.env.fuzzweek and fill in.
# Shell/systemd Environment= always overrides values in this file.

# Loopback only: nginx is the sole client and terminates TLS.
HACKME_FUZZWEEK_LISTEN=127.0.0.1:18090

# Durable submission log. Written before the operator is notified, so nothing is lost
# when Telegram is down or the token is missing.
HACKME_FUZZWEEK_STORE=/var/lib/hackme/fuzzweek/submissions.jsonl

# Promo window. RFC3339 or YYYY-MM-DD; a bare date means start-of-day for OPEN_AT and
# end-of-day (UTC) for DEADLINE. The server refuses submissions outside the window, so
# ending the promo is a change here plus a restart — not a page edit.
HACKME_FUZZWEEK_OPEN_AT=2026-11-23
HACKME_FUZZWEEK_DEADLINE=2026-11-30

# Global accepted-per-day cap, so a bad day cannot flood the operator.
HACKME_FUZZWEEK_MAX_PER_DAY=200

# Operator notifications (optional: submissions are still recorded without these).
# Create a bot with @BotFather, then message it once and read your numeric chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
HACKME_TELEGRAM_BOT_TOKEN=
HACKME_TELEGRAM_CHAT_ID=
