# Optional: source before worker_autostart on home PC (GPU miner).
#   set -a && source scripts/ops/desktop_worker.env.example && set +a
#
COORD_URL=https://hackme.tech/pool/coordinator
WORKER_ID=worker-kapa-pc
BATCH_SIZE=4194304
GPU_CHUNK=4194304
HACKME_GPU_BACKEND=opencl
SEARCH_TIMEOUT_MS=2500
# Home GPU: no claim cooldown (max throughput).
# HACKME_WORKER_CLAIM_COOLDOWN_MS=0
HACKME_WORKER_CLAIM_TIMEOUT=45s
HACKME_WORKER_SUBMIT_TIMEOUT=90s
