# Optional: source before worker_autostart on home PC (GPU miner).
#   set -a && source scripts/ops/desktop_worker.env.example && set +a
#
# Direct coordinator (bypass CF) + large batch — see docs/POOL_DIRECT_COORDINATOR.md
COORD_URL=http://132.243.112.100:18083
HACKME_POOL_COORDINATOR_URL=http://132.243.112.100:18083
HACKME_POOL_DIRECT=1
WORKER_ID=worker-desktop-01
BATCH_SIZE=16777216
GPU_CHUNK=4194304
HACKME_WORKER_BATCH_SIZE=16777216
HACKME_GPU_BACKEND=cuda
HACKME_DESKTOP_GPU_POOL=1
SEARCH_TIMEOUT_MS=12000
# Fast GPUs: ≥100ms claim cooldown (0 hammers claim → 429 bans).
HACKME_WORKER_CLAIM_COOLDOWN_MS=100
HACKME_WORKER_CLAIM_TIMEOUT=90s
HACKME_WORKER_SUBMIT_TIMEOUT=120s
