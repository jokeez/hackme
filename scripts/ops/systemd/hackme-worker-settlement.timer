[Unit]
Description=Run HackMe worker payout settlement (sequential payouts can take several minutes)

[Timer]
OnBootSec=45s
# After the oneshot unit finishes — not OnUnitActiveSec (that retriggers while a long run is still active).
OnUnitInactiveSec=3min
RandomizedDelaySec=15s
Persistent=true
Unit=hackme-worker-settlement.service

[Install]
WantedBy=timers.target
