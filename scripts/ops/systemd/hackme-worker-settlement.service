[Unit]
Description=HackMe Worker Payout Settlement
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hackme
EnvironmentFile=/opt/hackme/.env.settlement
ExecStart=/opt/hackme/scripts/ops/settle_worker_payouts.sh
User=hackme
Group=hackme

[Install]
WantedBy=multi-user.target
