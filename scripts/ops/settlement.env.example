COORD_URL=http://127.0.0.1:18081
CHAIN_BASE=http://127.0.0.1:18080
LOCAL_BASE=http://127.0.0.1:8080
ADMIN_TOKEN=CHANGE_ME
# Coordinator admin (required when HACKME_COORDINATOR_REQUIRE_ADMIN_TOKEN=1). Or use .secrets/hackme_coordinator_admin_token on VPS.
# COORD_ADMIN_TOKEN=CHANGE_ME
MIN_SETTLE_HMC=0.001
DAILY_FORCE_INTERVAL_SEC=86400
DAILY_MIN_SETTLE_HMC=0.0001
# FORCE_SETTLE_ALL=0
MAX_UNSETTLED_HMC=0.5
MAX_SWEEP_ETA_SEC=93600
EXPECTED_WALLET_SOURCES=canonical_peer,local_db
STATE_FILE=/opt/hackme/data/worker_settlement_state.json
# settle_worker_payouts.sh locks ${STATE_FILE}.flock (flock): do not run two instances with the same STATE_FILE on one host.
# Optional static fallback mapping (one worker_id recommended when coordinator omits workers{}):
# WORKER_PAYOUT_MAP=worker-kapa-pc=HMC-xxxx
