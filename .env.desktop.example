# Copy to .env.desktop (gitignored). First run of desktop_mode_up.sh can generate this for you.

HACKME_BIND_ADDR=127.0.0.1:8080
HACKME_ADMIN_TOKEN=change-me-generate-with-openssl-rand-hex-24
HACKME_REQUIRE_ADMIN_TOKEN=1
HACKME_DESKTOP_MODE=1

# worker = public pool follower (default); command = local chain leader
DESKTOP_PROFILE=worker

HACKME_PUBLIC_AUTHORITY_BASE=https://hackme.tech
HACKME_CANONICAL_CHAIN_URL=https://hackme.tech

# Optional: loaded from .secrets/hackme_coordinator_admin_token if empty
# HACKME_POOL_COORDINATOR_TOKEN=

# GPU desktop pool (high GH): direct coordinator + 16M batch + claim cooldown ≥100ms.
# Casual CF HTTPS remains default when HACKME_DESKTOP_GPU_POOL is unset.
# HACKME_DESKTOP_GPU_POOL=1
# HACKME_POOL_DIRECT=1
# HACKME_POOL_COORDINATOR_URL=http://132.243.112.100:18083
# COORD_URL=http://132.243.112.100:18083
# HACKME_WORKER_BATCH_SIZE=16777216
# GPU_CHUNK=4194304
# HACKME_WORKER_CLAIM_COOLDOWN_MS=100
# HACKME_WORKER_CLAIM_TIMEOUT=90s
# HACKME_WORKER_SUBMIT_TIMEOUT=120s
# See docs/POOL_DIRECT_COORDINATOR.md

# Pool-distributed B2B: coordinator relays settlements to this URL (public) or pull-mode when loopback.
# Desktop default is pull via coordinator outbox — no public URL required.
# HACKME_ORDERS_SETTLE_BASE=https://your-public-node.example:8080

# Payout wallet for your worker id (must match VPS WORKER_PAYOUT_MAP for settlement)
WORKER_PAYOUT_MAP=worker-my-pc=HMC-your-address-here

# PoH+fuzz hybrid under one worker_id (default off; enable for desktop dig tests)
# HACKME_WORKER_HYBRID_FUZZ=1
# HACKME_WORKER_HYBRID_FUZZ_MODE=inline
# HACKME_WORKER_HYBRID_FUZZ_CONCURRENCY=1
# HACKME_WORKER_HYBRID_FUZZ_CLAIM_GAP_MS=200
