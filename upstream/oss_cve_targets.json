      "upstream_src": [],
      "include_dirs": ["."],
      "wasm_guard": "sheredom_json_guard",
      "cwe": ["CWE-125"],
      "priority": 3
    },
    {
      "id": "expat",
      "repo": "https://github.com/libexpat/libexpat",
      "ref": "master",
      "title": "libexpat/libexpat · XML_Parse",
      "driver": "expat_stdin",
      "upstream_src": ["expat/lib/xmlparse.c", "expat/lib/xmltok.c", "expat/lib/xmlrole.c", "expat/lib/xmltok_impl.c", "expat/lib/xmltok_ns.c", "expat/lib/random_getrandom.c"],
