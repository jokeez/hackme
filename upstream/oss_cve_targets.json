      "cwe": ["CWE-125", "CWE-787"],
      "priority": 2
    }
  ],
  "rotation": {
    "note": "nightly picks 2 targets by day-of-year mod queue length",
    "queue": ["jsmn", "mjson", "yyjson", "parson", "jansson", "tomlc99", "expat", "sheredom", "inih", "md4c", "cjson"]
  }
